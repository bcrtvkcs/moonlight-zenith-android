<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:id="@+id/floatButton"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:padding="8dp"
        android:background="@drawable/m3_float_button_bg"
        android:elevation="6dp" />

    <FrameLayout
        android:id="@+id/toolbar_overflow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="14dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="#45464F"
            app:cardBackgroundColor="#F2191B23">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Row 1: Primary Input & Mode Controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <RelativeLayout
                        android:id="@+id/virtualKeyEsc"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_primary_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_esc"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="#DEE0FF" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualKeyWin"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_primary_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_win"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="#DEE0FF" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualKeySystemMenu"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_system_menu"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualMouseMiddleButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_mouse_middle_key"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/onScreenGamePad"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1.8"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_primary_chip_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/on_screen_game_pad"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="#DEE0FF" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/touchScreenModeMenu"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1.8"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_primary_chip_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/input_touchscreen_mode"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="#DEE0FF" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/touchPadModeMenu"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1.8"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_primary_chip_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/input_touchpad_mode"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="#DEE0FF" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/toggleSoftKeyboardMenu"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1.8"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_primary_chip_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/toggle_soft_keyboard"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="#DEE0FF" />
                    </RelativeLayout>
                </LinearLayout>

                <!-- Row 2: System & Clipboard Shortcuts -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <RelativeLayout
                        android:id="@+id/virtualKeyExitProgram"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_exit_program"
                            android:textSize="12sp"
                            android:textColor="#FFB4AB" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualKeyScreenshot"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_screenshot"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualKeyTaskManager"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg"
                        tools:ignore="DuplicateIds">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_taskmgr"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualKeyExplorer"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg"
                        tools:ignore="DuplicateIds">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_explorer"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualKeyCopy"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_copy"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualKeyCut"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_cut"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualKeyPaste"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_paste"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualKeySelectAll"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_select_all"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>
                </LinearLayout>

                <!-- Row 3: Virtual Desktop Shortcuts -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <RelativeLayout
                        android:id="@+id/virtualKeyShowDesktop"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_desktop"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualKeyTaskView"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_task_view"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualKeyNewDesktop"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_new_desktop"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualKeyDeleteDesktop"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_delete_desktop"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualKeyLeftDesktop"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_left_desktop"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualKeyRightDesktop"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_right_desktop"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>
                </LinearLayout>

                <!-- Row 4: NVIDIA Overlay Shortcuts -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:id="@+id/virtualKeyNvidiaOverflow"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_nvidia_overflow"
                            android:textSize="12sp"
                            android:textColor="#6DD58C" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualKeyNvidiaScreenshot"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_nvidia_screenshot"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualKeyNvidiaPhotoMode"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_nvidia_photo_mode"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualKeyNvidiaGameFilter"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_nvidia_game_filter"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualKeyNvidiaInstantlyRelay"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_nvidia_instantly_relay"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/virtualKeyNvidiaRecord"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/game_overflow_menu_height"
                        android:layout_weight="1"
                        android:layout_margin="3dp"
                        android:background="@drawable/m3_overflow_chip_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="@string/virtual_key_nvidia_record"
                            android:textSize="12sp"
                            android:textColor="#E3E1EC" />
                    </RelativeLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</merge>
