<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Material Design 3 (Material You) Base Theme for Moonlight Zenith -->
    <style name="AppBaseTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>

        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>

        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/m3_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/m3_on_tertiary_container</item>

        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorErrorContainer">@color/m3_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container</item>

        <item name="android:colorBackground">@color/m3_background</item>
        <item name="colorOnBackground">@color/m3_on_background</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>

        <item name="colorSurfaceContainerLowest">@color/m3_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/m3_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surface_container_highest</item>

        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>

        <item name="android:windowBackground">@color/m3_background</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="android:preferenceStyle">@style/Preference.Moonlight.M3</item>
        <item name="android:checkBoxPreferenceStyle">@style/Preference.Moonlight.M3.Switch</item>
        <item name="android:dialogPreferenceStyle">@style/Preference.Moonlight.M3</item>
        <item name="android:preferenceCategoryStyle">@style/Preference.Moonlight.M3.Category</item>
        <item name="android:listDivider">@null</item>

        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Moonlight.MaterialAlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Moonlight.BottomSheetDialog</item>
    </style>

    <style name="Preference.Moonlight.M3" parent="">
        <item name="android:layout">@layout/m3_preference_item</item>
    </style>

    <style name="Preference.Moonlight.M3.Switch" parent="">
        <item name="android:layout">@layout/m3_preference_item</item>
        <item name="android:widgetLayout">@layout/m3_preference_widget_switch</item>
    </style>

    <style name="Preference.Moonlight.M3.Category" parent="">
        <item name="android:layout">@layout/m3_preference_category</item>
    </style>

    <!-- Application theme -->
    <style name="AppTheme" parent="AppBaseTheme" />

    <!-- Zenith AMOLED Pure Black Theme Overlay -->
    <style name="ThemeOverlay.Moonlight.AMOLED" parent="">
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#0A0B0F</item>
        <item name="colorSurfaceContainer">#12131A</item>
        <item name="colorSurfaceContainerHigh">#1A1C24</item>
        <item name="colorSurfaceContainerHighest">#242630</item>
    </style>

    <!-- Material You AMOLED Pure Black Theme Overlay -->
    <style name="ThemeOverlay.Moonlight.DynamicAMOLED" parent="">
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#0C0C0C</item>
        <item name="colorSurfaceContainer">#131313</item>
        <item name="colorSurfaceContainerHigh">#1B1B1B</item>
        <item name="colorSurfaceContainerHighest">#242424</item>
    </style>

    <style name="StreamBaseTheme" parent="AppBaseTheme">
        <!-- Transparent streaming background to avoid extra overdraw -->
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Stream activity theme -->
    <style name="StreamTheme" parent="StreamBaseTheme">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Material 3 AlertDialog Overlay (28dp rounded corners) -->
    <style name="ThemeOverlay.Moonlight.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Moonlight.Dialog</item>
    </style>

    <style name="ShapeAppearance.Moonlight.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Material 3 BottomSheetDialog Overlay (28dp top rounded corners) -->
    <style name="ThemeOverlay.Moonlight.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Moonlight.BottomSheet.Modal</item>
    </style>

    <style name="Widget.Moonlight.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Moonlight.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Moonlight.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Material 3 Shape Appearances for Cards & Box Art Posters -->
    <style name="ShapeAppearance.Moonlight.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Moonlight.Poster" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Moonlight.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
