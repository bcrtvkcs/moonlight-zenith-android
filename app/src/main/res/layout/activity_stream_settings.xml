<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    tools:context=".preferences.StreamSettings">

    <!-- Material Design 3 Top App Bar -->
    <LinearLayout
        android:id="@+id/m3_settings_top_bar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsBackButton"
            style="?attr/materialIconButtonFilledTonalStyle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:preferKeepClear="true"
            app:icon="@drawable/ic_m3_back"
            app:iconSize="22dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <TextView
            android:id="@+id/settingsTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:preferKeepClear="true"
            android:text="@string/category_basic_settings"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Material Design 3 Scrollable Pill Category Tabs (Default "Tabbed" mode) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/settingsTabLayout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="4dp"
        android:background="@android:color/transparent"
        app:tabMode="scrollable"
        app:tabGravity="start"
        app:tabContentStart="16dp"
        app:tabPaddingStart="16dp"
        app:tabPaddingEnd="16dp"
        app:tabIndicator="@drawable/m3_tab_pill_indicator"
        app:tabIndicatorGravity="stretch"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorColor="?attr/colorSecondaryContainer"
        app:tabSelectedTextColor="?attr/colorOnSecondaryContainer"
        app:tabTextColor="?attr/colorOnSurfaceVariant"
        app:tabTextAppearance="?attr/textAppearanceTitleSmall"
        app:tabRippleColor="@android:color/transparent" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/stream_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Pure Material You Expressive Floating Bottom Navigation Bar (Optional, hidden in Tabbed mode) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/m3FloatingBottomBarCard"
            android:layout_width="wrap_content"
            android:layout_height="80dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="40dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <HorizontalScrollView
                android:id="@+id/m3FloatingBottomBarScroll"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:clipToPadding="false"
                android:paddingStart="7dp"
                android:paddingEnd="7dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">

                    <View
                        android:id="@+id/m3FloatingBottomBarIndicator"
                        android:layout_width="88dp"
                        android:layout_height="66dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="2dp" />

                    <LinearLayout
                        android:id="@+id/m3FloatingBottomBarContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical" />

                </FrameLayout>

            </HorizontalScrollView>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</LinearLayout>
